# vetinari dev environment — direnv.
#
# After creating or editing this file, run:  direnv allow
#
# Two responsibilities:
#   1. load the nix dev shell (shell.nix)
#   2. bring crossbridge up so this repo is a reachable peer

# --- 1. nix dev shell ------------------------------------------------------
# Loads shell.nix: rustc, cargo, jj, zellij, sqlite, python3, gh, etc.
# `use nix` re-evaluates shell.nix on every reload — install `nix-direnv` and
# it transparently caches the result, making cd-in near-instant.
use nix

# --- 2. crossbridge bring-up ----------------------------------------------
# vetinari joins a crossbridge peer group so sibling repos can submit crosslink
# issues to it (see .design/crossbridge-integration.md, crosslink issue #25).
#
# `crossbridge_up` idempotently ensures (a) the host-wide crossbridge-supervisor
# and (b) a crossbridge-server for this repo are running. Every step is a no-op
# when already up, so it is safe to run on each direnv reload.
#
# For the planned multi-repo federation, lift this block into
# ~/.config/direnv/lib/crossbridge.sh (direnv auto-sources lib/*.sh) so each
# repo's .envrc is just `use nix` + `crossbridge_up`.

# The peer group every federated vetinari instance shares. It MUST match the
# group its peers register under or they will not discover each other.
# Override per-machine by exporting CROSSBRIDGE_GROUP before direnv runs.
export CROSSBRIDGE_GROUP="${CROSSBRIDGE_GROUP:-amd-psp}"
export CROSSBRIDGE_SLUG="${CROSSBRIDGE_SLUG:-vetinari}"

crossbridge_up() {
  if ! command -v crossbridge-server >/dev/null 2>&1; then
    log_status "crossbridge: CLI not on PATH — skipping bring-up"
    return 0
  fi

  local root logdir
  root="${CROSSBRIDGE_SOCKET_ROOT:-${XDG_RUNTIME_DIR:-/run}/crossbridge}"
  logdir="${XDG_STATE_HOME:-$HOME/.local/state}/crossbridge"
  mkdir -p "$logdir"

  # (a) supervisor — a host-wide singleton. A second supervisor WIPES the
  #     socket root on startup, so only ever start one when register.socket is
  #     entirely absent, and serialize that decision with a host-global lock.
  #     A stale socket left by an unclean crash must be removed by hand — that
  #     is the safe failure mode, versus auto-wiping a live topology.
  (
    flock 9
    if [ ! -S "$root/register.socket" ]; then
      log_status "crossbridge: starting supervisor"
      nohup crossbridge-supervisor >>"$logdir/supervisor.log" 2>&1 & disown
      n=0
      while [ ! -S "$root/register.socket" ] && [ "$n" -lt 25 ]; do
        sleep 0.2; n=$((n + 1))
      done
    fi
  ) 9>"$logdir/.supervisor.lock"

  # (b) this repo's crossbridge-server. Its socket directory <root>/<slug>/
  #     appears once it has registered; treat that as "already up".
  if [ ! -d "$root/$CROSSBRIDGE_SLUG" ]; then
    log_status "crossbridge: starting server (slug=$CROSSBRIDGE_SLUG group=$CROSSBRIDGE_GROUP)"
    nohup crossbridge-server \
      --group "$CROSSBRIDGE_GROUP" \
      --slug "$CROSSBRIDGE_SLUG" \
      --repo-path "$PWD" \
      >>"$logdir/server-$CROSSBRIDGE_SLUG.log" 2>&1 & disown
  fi
}

crossbridge_up
